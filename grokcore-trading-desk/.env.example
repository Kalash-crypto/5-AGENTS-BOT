NODE_ENV=development
APP_MODE=research
LIVE_TRADING_ENABLED=false
SAFE_BY_DEFAULT=true

# RPC / wallet
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=
WALLET_ADDRESS=

# Exchange / API services
GMGN_API_KEY=
GMGN_BASE_URL=https://api.gmgn.ai
JUPITER_API_URL=https://quote-api.jup.ag
TRENDS_API_BASE_URL=

# Risk controls
MAX_POSITION_USD=250
MANDATORY_STOP_LOSS_PERCENT=-8
SLIPPAGE_BPS=50
MIN_CONFIDENCE=0.6

# Optional network config
SUPPORTED_CHAINS=solana,base,bsc,ethereum
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Security notes:
# - Leave LIVE_TRADING_ENABLED=false unless you fully understand the risks.
# - The system is safe by default and requires explicit opt-in to live execution.
# - Provide a valid private key only on a secure system offline from accidental leaks.
